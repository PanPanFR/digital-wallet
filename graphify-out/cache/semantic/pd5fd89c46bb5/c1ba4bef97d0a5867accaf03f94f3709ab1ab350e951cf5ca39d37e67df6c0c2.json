{"nodes": [{"id": "docs_specs_2026_09_03_svelte_rewrite_design_sveltekit_rewrite", "label": "SvelteKit Rewrite Design", "file_type": "document", "source_file": "docs/specs/2026-09-03-svelte-rewrite-design.md", "source_location": "1-140", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Approved design: lighter stack, fewer abstractions, idiomatic framework patterns, feature parity with old app minus OCR."}, {"id": "docs_specs_2026_09_03_svelte_rewrite_design_stack_decisions", "label": "Stack Decisions", "file_type": "concept", "source_file": "docs/specs/2026-09-03-svelte-rewrite-design.md", "source_location": "19-32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SvelteKit 2 (Svelte 5 runes), SSR via adapter-cloudflare static assets + Worker, D1 unchanged, Tailwind v4, lucide-svelte, zod, CSS bars, runes stores, hand-rolled SW."}, {"id": "docs_specs_2026_09_03_svelte_rewrite_design_auth_flow", "label": "Auth Flow (hooks guard, setup/login, rate limit)", "file_type": "concept", "source_file": "docs/specs/2026-09-03-svelte-rewrite-design.md", "source_location": "64-80", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "hooks.server.ts guard: /api/* gets 401 JSON never redirect, everything else redirects /login; setup vs login modes; D1 rate_limits table survives isolate restarts; CSRF via SvelteKit form action built-ins plus manual Origin check on JSON endpoints."}, {"id": "docs_specs_2026_09_03_svelte_rewrite_design_form_actions_pattern", "label": "Form Actions + Load Functions Pattern", "file_type": "rationale", "source_file": "docs/specs/2026-09-03-svelte-rewrite-design.md", "source_location": "23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pages + API in one project; official Cloudflare adapter; form actions and load functions eliminate client-side fetch/state boilerplate. No client-api.ts, invalidateAll() refreshes after mutations."}, {"id": "docs_specs_2026_09_03_svelte_rewrite_design_workers_over_pages", "label": "Cloudflare Workers over Pages", "file_type": "rationale", "source_file": "docs/specs/2026-09-03-svelte-rewrite-design.md", "source_location": "25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cloudflare's primary platform going forward; Pages is in maintenance mode; D1 binding and env vars live in config, not dashboard clicks."}, {"id": "docs_specs_2026_09_03_svelte_rewrite_design_d1_database_unchanged", "label": "D1 Database (unchanged)", "file_type": "rationale", "source_file": "docs/specs/2026-09-03-svelte-rewrite-design.md", "source_location": "26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same database, same schema.sql; all existing data works with no migration. Password hashing format identical so existing master password keeps working."}, {"id": "docs_specs_2026_09_03_svelte_rewrite_design_css_bars", "label": "Custom CSS Bars (no chart lib)", "file_type": "rationale", "source_file": "docs/specs/2026-09-03-svelte-rewrite-design.md", "source_location": "30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Old app has no chart library; analytics used CSS bars - keep that. SQL GROUP BY aggregates, CSS bars client-side."}, {"id": "docs_specs_2026_09_03_svelte_rewrite_design_hand_rolled_service_worker", "label": "Hand-rolled Minimal Service Worker", "file_type": "rationale", "source_file": "docs/specs/2026-09-03-svelte-rewrite-design.md", "source_location": "32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "About 30 lines, no Workbox; cache-first static assets, network-only data; installable + offline shell. Data requires connectivity (same as old app)."}, {"id": "docs_specs_2026_09_03_svelte_rewrite_design_ocr_dropped", "label": "OCR Receipt Scanning Dropped", "file_type": "rationale", "source_file": "docs/specs/2026-09-03-svelte-rewrite-design.md", "source_location": "15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-goal by explicit user decision; Tesseract.js dependency removed entirely."}, {"id": "docs_specs_2026_09_03_svelte_rewrite_design_theme_toggle", "label": "Dark/Light Theme Persistence", "file_type": "concept", "source_file": "docs/specs/2026-09-03-svelte-rewrite-design.md", "source_location": "108", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CSS class toggle, preference in localStorage, defaults to system via prefers-color-scheme; port ThemeToggle component from React."}, {"id": "docs_specs_2026_09_03_svelte_rewrite_design_ai_json_endpoints", "label": "AI JSON Endpoints (parse + report)", "file_type": "rationale", "source_file": "docs/specs/2026-09-03-svelte-rewrite-design.md", "source_location": "93-99", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI parse stays JSON because results need interactive preview/confirmation before saving; report goes Gemini + D1 data. Origin header check replaces csrf.ts."}, {"id": "docs_specs_2026_09_03_svelte_rewrite_design_nextjs_predecessor", "label": "Next.js Finance Tracker (predecessor)", "file_type": "concept", "source_file": "docs/specs/2026-09-03-svelte-rewrite-design.md", "source_location": "5", "source_url": "https://github.com/PanPanFR/finance-tracker", "captured_at": null, "author": null, "contributor": null, "rationale": "Next.js 15 + React 19 app this design replaces; source of ported auth.ts logic, globals.css, Navigation, Toast, ConfirmModal components."}], "edges": [{"source": "docs_specs_2026_09_03_svelte_rewrite_design_sveltekit_rewrite", "target": "_github_workflows_deploy_deploy_workflow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/specs/202